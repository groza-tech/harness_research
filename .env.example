# Провайдер LLM. Используем OpenRouter — как в соседних проектах phd/.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Три весовых класса моделей для Э1/Э4 (курс обмена «модель ↔ харнесс»).
# Пиннинг обязателен: слаги с датой/версией, а не плавающие алиасы.
HA_MODEL_LIGHT=qwen/qwen3.7-flash
HA_MODEL_MID=deepseek/deepseek-v4-flash-0731
HA_MODEL_HEAVY=xiaomi/mimo-v2.5-pro

# Модель по умолчанию (основная масса прогонов — на лёгкой).
HA_MODEL=deepseek/deepseek-v4-flash-0731

# Транспорт: таймауты и ретраи. Хвост долгих вызовов дороже, чем пропуск сессии.
HA_TIMEOUT_S=90
HA_MAX_ATTEMPTS=6
HA_BACKOFF_BASE_S=3
HA_BACKOFF_MAX_S=45

# Температура фиксированная и низкая, но НЕ ноль (§4.4 дизайн-дока).
HA_TEMPERATURE=0.4

# Потолок ответа и режим рассуждений. Пусто = НЕ ограничивать: модель работает
# как в реальном контуре. Тесный HA_MAX_TOKENS у рассуждающих моделей съедается
# мыслями, и content приходит пустым с finish_reason=length. От разгона
# защищает бюджет токенов на сессию (runner.max_tokens_per_session), а не этот
# потолок. Заполняйте только если сознательно экономите.
HA_MAX_TOKENS=
HA_REASONING=
